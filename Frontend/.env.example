# Copy to Frontend/.env and adjust. Never commit .env — the repository root .gitignore excludes it.
# Only variables prefixed VITE_ are exposed to browser code; anything else stays build-time only.
# Whatever is put here is readable by anyone who opens the site, so it never holds a secret.

# Base URL of the API, including the /api prefix the server mounts its routes under.
# Must match an entry in the server's CORS_ORIGINS-approved pairing: the browser calls this URL
# from http://localhost:5173, and the server must be allowing that exact origin back.
VITE_API_URL=http://localhost:3000/api

#API Key
VITE_GOOGLE_MAPS_API_KEY =