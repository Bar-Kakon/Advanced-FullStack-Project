{
  "name": "contractor-coordination-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React (Vite) client, alongside the static HTML/CSS screen prototypes it is replacing one screen at a time.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "build:screens": "tsc -p tsconfig.screens.json",
    "watch:screens": "tsc -p tsconfig.screens.json --watch",
    "verify:profile-data": "node scripts/verify-profile-real-data.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.4.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "axios": "^1.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  }
}
