# Copy to Backend/.env and fill in. Never commit .env — the repository root .gitignore excludes it.
# Only the variables the current server foundation actually reads are listed here.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on. Heroku injects its own value.
PORT=3000

# MongoDB connection string — a local mongod or a MongoDB Atlas mongodb+srv URI.
MONGODB_URI=mongodb://127.0.0.1:27017/contractor-coordination-platform

# Comma-separated browser origins allowed to call this API. Required, and never "*".
# PLACEHOLDER — no client origin is decided yet. The value below is only the Vite dev-server
# default; replace it with the real client origin(s) before deploying.
# The API sends credentials (the Refresh Token cookie), so this list must stay exact.
CORS_ORIGINS=http://localhost:5173

# ── Authentication tokens ─────────────────────────────────────────────────────
# Two separate credentials with two separate secrets. Using one value for both would make an
# Access Token and a Refresh Token interchangeable, which the server refuses to start with.
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# PLACEHOLDERS — never commit real secrets.

# Signs the short-lived token that authenticates ordinary API requests. Minimum 32 characters.
ACCESS_TOKEN_SECRET=replace-me-with-a-long-random-value-min-32-chars

# Signs the long-lived token that buys a new Access Token. MUST differ from ACCESS_TOKEN_SECRET.
REFRESH_TOKEN_SECRET=replace-me-with-a-different-long-random-value

# Lifetimes in seconds. The refresh lifetime must be greater than the access lifetime.
# Defaults if unset: 900 (15 minutes) and 604800 (7 days).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# ── Terms of Service ──────────────────────────────────────────────────────────
# Recorded with every Register consent, so an acceptance stays provable after the Terms change.
# It comes from here rather than the request body: the server knows which version it serves, and a
# client could claim any value.
# PLACEHOLDER — no Terms document has been written yet, so "draft" is the honest value and is also
# the default if this is unset. Replace it with the real version the moment Terms are published.
# ⚠ The ONLY variable here that is missing-but-silent: the server starts fine without it and quietly
# records "draft". Every other optional variable reveals a wrong value through behaviour; this one
# writes it into users.termsAcceptances[], which is append-only and cannot be corrected afterwards.
# When Terms are published, add this line to every .env that already exists — re-copying this file
# is not enough for a .env that was created before the variable was.
TERMS_VERSION=draft

# ── Client URL ────────────────────────────────────────────────────────────────
# Where the React client is served. The password-reset email builds its link against it:
#   ${FRONTEND_URL}/reset-password?token=<raw token>
# REQUIRED — the server refuses to start without it. A reset email carrying the wrong link is worse
# than a server that will not boot, and a default here would hide a wrong value in production.
# Local development: the Vite dev server, which is the same origin CORS_ORIGINS names.
FRONTEND_URL=http://localhost:5173

# ── Outgoing mail — Brevo SMTP via Nodemailer ─────────────────────────────────
# Brevo is the email service; Nodemailer is the library that talks to it. Ordinary authenticated
# SMTP, so there is no Brevo SDK and no API key in the application.
#
# ALL FOUR TOGETHER, OR NONE. Three out of four is a deployment that looks configured and fails on
# the first send, so the server refuses to start on a partial set. With none of them set it starts
# in LOG MODE: no mail is sent and every attempt writes a warning naming the recipient — enough to
# develop against without a Brevo account, and impossible to mistake for working.
#
# Where the values come from: Brevo → SMTP & API → SMTP tab.
#   SMTP_HOST  the relay host Brevo shows (smtp-relay.brevo.com at the time of writing)
#   SMTP_USER  the login Brevo shows on that tab — it is NOT necessarily your account email
#   SMTP_PASS  the SMTP key generated on that tab. A password, not the REST API key.
#   MAIL_FROM  the sender. Must be an address Brevo has verified, or the relay rejects the message.
# PLACEHOLDERS — never commit real values. Put the real ones in Backend/.env, which is gitignored.
SMTP_HOST=smtp-relay.brevo.com
# 587 opens in the clear and upgrades through STARTTLS; 465 is TLS from the first byte. The code
# derives which handshake to use from this number, so the two can never disagree. Default: 587.
SMTP_PORT=587
SMTP_USER=replace-me-with-the-brevo-smtp-login
SMTP_PASS=replace-me-with-the-brevo-smtp-key
MAIL_FROM=FieldSync <replace-me@your-verified-domain.example>

# ── Google Maps Platform ──────────────────────────────────────────────────────
# SERVER-SIDE key. Used for the Routes API (Compute Route Matrix) and Places
# lookups made by the backend. It must NEVER be sent to the browser.
#
# Enable on this key:  Routes API  +  Places API (New)
# Restrict it by:      IP address (your server), and by those two APIs only.
#
# Leaving it unset is supported: the location endpoints answer
# LOCATION_SERVICE_NOT_CONFIGURED instead of the server refusing to start.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_MS=8000

# ── Google sign-in (OAuth) ────────────────────────────────────────────────────
# The OAuth 2.0 Client ID of this deployment's WEB application, from
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
#
# NOT a secret. It is the audience every Google ID token must be issued for, and the browser is
# given the SAME value as VITE_GOOGLE_OAUTH_CLIENT_ID. There is deliberately no client SECRET
# anywhere in this application: the browser obtains the ID token and the server only verifies it
# against Google's published keys. A client secret exists for a code-exchange flow this product
# does not use.
#
# Set on the OAuth client before it will work:
#   Authorised JavaScript origins:  the client origin(s) — http://localhost:5173 in development
#
# A DIFFERENT credential from both Maps keys, and it must never hold either value.
#
# Leaving it unset is supported: POST /api/auth/google and /api/auth/google/link answer
# GOOGLE_AUTH_NOT_CONFIGURED, and email/password login is completely unaffected.
GOOGLE_OAUTH_CLIENT_ID=

# ── Billing — PayPal ──────────────────────────────────────────────────────────
# ALL THREE TOGETHER, OR NONE — the rule SMTP follows, for the same reason. Two out of three is a
# deployment that boots, renders an upgrade button and fails the moment somebody presses it, so
# the server refuses to start on a partial set.
#
# With none of them set the billing provider is `none`: the Free plan works completely, the plan
# comparison and the current-plan surface render, and checkout answers
# BILLING_PROVIDER_NOT_CONFIGURED instead of pretending. Nobody is ever kept off Free by a missing
# payment credential.
#
# Where the values come from: the PayPal Developer dashboard — a REST app for the credentials, and
# a webhook subscribed to the billing events for its id.
#   PAYPAL_CLIENT_ID      the REST app's client id, exchanged for an OAuth token
#   PAYPAL_CLIENT_SECRET  the REST app's secret. A real secret: never logged, never sent to the
#                         browser.
#   PAYPAL_WEBHOOK_ID     identifies WHICH webhook a callback claims to be from, and is required
#                         for PayPal to verify a signature. Without it nothing can be authenticated,
#                         which is why it sits in the same all-or-none set as the credentials.
#
# The webhook must be subscribed to these events, or the corresponding transition never happens:
#   BILLING.SUBSCRIPTION.ACTIVATED       activates a paid period
#   BILLING.SUBSCRIPTION.UPDATED         applies an approved tier change
#   PAYMENT.SALE.COMPLETED               extends the period a recurring charge paid for
#   BILLING.SUBSCRIPTION.CANCELLED       schedules the drop to Free at period end
#   BILLING.SUBSCRIPTION.EXPIRED         same
#   BILLING.SUBSCRIPTION.SUSPENDED       same
#   BILLING.SUBSCRIPTION.PAYMENT.FAILED  marks the attempt failed
#
# PLACEHOLDERS — never commit real values. The real ones go in Backend/.env, which is gitignored.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Defaults to the SANDBOX. Production is https://api-m.paypal.com, and reaching it is an explicit
# act — no missing value can put a deployment on the live endpoint by accident.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_MS=10000

# The tiers must also exist AT PayPal before a checkout can be opened. `npm run provision:paypal-plans`
# creates the Product and one Billing Plan per paid tier from the prices in the `plans` collection,
# and writes the ids back to `plans.providerPlans.paypal`. It is idempotent and safe to re-run.
