{
  "name": "contractor-coordination-platform-backend",
  "version": "0.0.0",
  "private": true,
  "description": "Express + Mongoose API server for the Contractor Coordination Platform.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "verify:register-txn": "tsx scripts/verify-register-transaction.ts",
    "verify:password-reset": "tsx scripts/verify-password-reset.ts",
    "verify:rate-limit": "tsx scripts/verify-rate-limit.ts",
    "verify:employee-lifecycle": "tsx scripts/verify-employee-lifecycle.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
